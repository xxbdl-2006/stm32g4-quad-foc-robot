<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motor_control</name>
  <version>2.4.1</version>
  <description>
    四轮底盘控制器：/cmd_vel 解算为四轴轮速，发布 /hw/motor_commands；
    同时把 /hw/motor_states 转成 /joint_states、/odom 与 TF。
    含按故障状态重新分配电流预算的力矩分配逻辑。
  </description>
  <maintainer email="embedded@hwb.local">HWB Embedded</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hw_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
