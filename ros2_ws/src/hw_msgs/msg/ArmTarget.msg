# 末端目标位姿指令。task_executor 或上层规划器 -> arm_control。
#
# 注意这里传的是**末端（吸盘中心）在臂基座系下的位姿**，不是关节角。
# 逆运动学与轨迹规划都在 arm_control 里做，上层只表达"末端要去哪儿"。
# 这样分工的理由：同一个末端目标往往对应两组关节解（肘上/肘下），
# 选哪一组取决于当前姿态 —— 那是控制器该管的事，不该让任务层去操心。
std_msgs/Header header

geometry_msgs/Pose target_pose     # 位置单位 m；姿态只取绕 Z 的 yaw，其余分量忽略

uint8 MOVE_CARTESIAN = 0           # 末端走直线（默认）。下压/提升必须用这个
uint8 MOVE_JOINT     = 1           # 关节空间插补。末端路径不保证是直线，但不会撞奇异
uint8 move_kind

# 整体时间缩放：1.0 = 按关节限速算出的时间；0.5 = 用两倍时间走过去（更慢更稳）。
# 对着易碎或轻的物块可以调小，调试阶段也用得上。
float32 speed_scale

# 当直线路径被拒绝（穿过工作空间内孔、或超出工作半径）时，是否允许自动改成
# "先抬到安全高度 -> 平移 -> 再下到目标"的三段绕行。
# 关掉它就变成严格拒绝：宁可不动，也不走一条上层没规划过的路。
bool allow_waypoint
